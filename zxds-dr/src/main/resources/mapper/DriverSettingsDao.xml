<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.zxds.dr.db.dao.DriverSettingsDao">
    <insert id="insertDriverSettings" parameterType="com.example.zxds.dr.db.pojo.DriverSettingsEntity">
        insert into tb_driver_settings
        set id = #{id},
            driver_id = #{driverId},
            settings = #{settings}
    </insert>
</mapper>
